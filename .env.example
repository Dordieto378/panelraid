# Optional: without Sanity configuration the site uses the sample articles.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-10-01
# Required for a private Sanity dataset; build-time only. Never prefix with PUBLIC_.
SANITY_API_READ_TOKEN=
# Set this to the final production URL before indexing.
SITE_URL=https://panelraid.example
# Studio values must match the frontend project and dataset.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Netlify Forms handles newsletter submissions in production.
