---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleFeed from '../components/ArticleFeed';
import { getArticles } from '../lib/content';
import { articleSummaries } from '../lib/types';
const articles = await getArticles();
---
<BaseLayout title="Anime, manga & gaming editorials | Panelraid" description="Browse Panelraid reviews, opinions, analyses, and discussions about anime, manga, and gaming." active="All"><div class="container archive"><header class="archive-header"><span class="eyebrow">REVIEWS · OPINIONS · ANALYSIS</span><h1>Ideas worth discussing<span style="color:#3b96d2">.</span></h1><p>Personal perspectives, deeper readings, and honest conversations about the worlds we love.</p></header><ArticleFeed client:visible articles={articleSummaries(articles)} pageSize={12} /></div></BaseLayout>
