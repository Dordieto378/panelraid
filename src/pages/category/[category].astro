---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleFeed from '../../components/ArticleFeed';
import { categories, articleSummaries } from '../../lib/types';
import { getArticles } from '../../lib/content';
export function getStaticPaths() { return categories.filter(c => c !== 'All').map(category => ({ params: { category: category.toLowerCase() }, props: { category } })); }
interface Props { category: string }
const { category } = Astro.props;
const descriptions: Record<string, string> = {
  Anime: 'Thoughtful reviews, character studies, strong opinions, and deeper conversations about anime worth watching.',
  Manga: 'Reviews, close readings, and discussions about the panels, creators, and ideas that stay with us.',
  Gaming: 'Honest opinions and deeper analysis of the games, characters, and worlds that keep us playing.',
};
const articles = (await getArticles()).filter(a => a.category === category);
---
<BaseLayout title={`${category} reviews, opinions & analysis | Panelraid`} description={descriptions[category]} active={category}><div class="container archive"><header class="archive-header"><span class="eyebrow">GO BEYOND THE SURFACE</span><h1>{category}<span style="color:#3b96d2">.</span></h1><p>{descriptions[category]}</p></header><ArticleFeed client:visible articles={articleSummaries(articles)} pageSize={12} showFilters={false} /></div></BaseLayout>
