---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getProducts } from '../lib/content';
const products = await getProducts();
---
<BaseLayout title="The Loot — Curated finds for your collection | Panelraid" active="The Loot"><div class="container archive"><header class="archive-header"><span class="eyebrow">GOOD READS. GREAT FINDS.</span><h1>A little loot. A lot to love<span style="color:#3b96d2">.</span></h1><p>The reading lists, collectibles, and little discoveries that make our shelves — and our days — a bit better.</p></header><p class="disclosure">{products.length ? 'Some links on this page are affiliate links. We may earn a commission when you buy, at no extra cost to you.' : 'No recommendations are currently listed.'} <a href="/affiliate-disclosure/">Read our disclosure.</a></p><div class="loot-grid">{products.map(product => <article class="loot-card"><img src={product.image} alt={product.imageAlt} width="600" height="375" loading="lazy" /><div class="loot-card-content"><span class="eyebrow">{product.label || 'ON OUR RADAR'}</span><h2>{product.name}</h2><p>{product.description}</p><a class="text-link" href={product.url} rel={product.url.startsWith('https://') ? 'sponsored noopener noreferrer' : undefined} target={product.url.startsWith('https://') ? '_blank' : undefined}>{product.priceLabel}<Icon name="arrow" size={17} /></a></div></article>)}</div>{products.length === 0 && <p class="prose">We’re putting together our next collection. Check back for fresh finds.</p>}</div></BaseLayout>
